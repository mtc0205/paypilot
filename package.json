{
  "name": "paypilot",
  "version": "1.0.0",
  "description": "PayPilot — the AI first mate for small merchants on PayPal. PayPal AI Hackathon 2026 entry.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "start": "node dist-server/src/server/index.js",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "ag-grid-community": "^33.3.0",
    "ag-grid-react": "^33.3.0",
    "lucide-react": "^0.468.0",
    "recharts": "^2.15.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@fontsource/inter": "^5.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.1"
  }
}
